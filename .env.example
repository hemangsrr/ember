# Required: Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=replace_with_your_bot_token
# Discord Developer Portal > General Information > Application ID; used for the dashboard install link.
DISCORD_CLIENT_ID=replace_with_your_application_id
# Discord Developer Portal > OAuth2 > Client Secret (never expose this in browser code).
DISCORD_CLIENT_SECRET=replace_with_your_oauth2_client_secret
# Must exactly match the OAuth2 redirect configured in the Discord Developer Portal.
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Required in production. Render supplies PORT automatically; set this only locally if desired.
PORT=3000

# Dashboard HTTP Basic Auth credentials. Change both before deployment.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-to-a-long-unique-password
# A long, random value used to sign login sessions.
SESSION_SECRET=replace_with_a_long_random_secret
